# Copy this file to ".env" (same folder) and edit. Real environment variables win over this file.
# Restart the server after changing it.

# Switch the local LLM fallback on ("none" turns it off)
LLM_PROVIDER=ollama

# Optional
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT_SECONDS=120

# Keep uploaded documents on disk (original file + extracted text) and reload them at startup.
# Leave empty to keep everything in memory only.
# DOCUMENT_STORAGE_DIR=data/documents

# How Word files are read: "python" (default, no page numbers) or "libreoffice" (needs LibreOffice;
# gives DOCX real page numbers; falls back to "python" if LibreOffice is missing).
# DOCX_ENGINE=python
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
